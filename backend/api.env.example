# Copy this file to backend/api.env and supply local values.
# Existing process environment variables take precedence over this file.

# Required: generate a random signing secret with at least 32 bytes of entropy.
# Example command: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Required: an explicitly configured PostgreSQL database URL.
# Example: postgresql://USER:PASSWORD@localhost:5432/simtrade
SQLALCHEMY_DATABASE_URI=

# Market-data networking is disabled unless explicitly enabled.
MARKET_DATA_ENABLED=false
# Supply a provider key only when MARKET_DATA_ENABLED=true.
API_KEY=

# Comma-separated browser origins; these are the development defaults.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
